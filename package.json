    "@xenova/transformers": "^2.17.2",
    "compromise": "^14.14.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fast-levenshtein": "^3.0.0",
    "framer-motion": "^12.4.10",
    "idb": "^8.0.2",
    "lucide-react": "^0.477.0",
