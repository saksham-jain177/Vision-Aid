{
  "name": "vision-aid",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI-powered computer vision platform for real-time face recognition and traffic analysis",
  "keywords": [
    "react",
    "typescript",
    "computer-vision",
    "face-recognition",
    "ai",
    "three.js"
  ],
  "scripts": {
